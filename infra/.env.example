# ==============================================================================
# Vivid Imagination Production Environment Configuration
# Consolidates all application, database, and infrastructure settings
# Used by Docker Compose (env_file: - .env)
# ==============================================================================

# --- Container Image Tagging ---
API_IMAGE=ghcr.io/your-username/vividimagination.backend.api
APP_TAG=latest

# --- ASP.NET Core Runtime Settings ---
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_HTTP_PORTS=8080
AllowedHosts=*

# --- PostgreSQL Relational Database ---
POSTGRES_USER=vivid_user
POSTGRES_PASSWORD=ChangeThisSecurePassword123!
POSTGRES_DB=vivid_imagination
ConnectionStrings__Postgres=Host=postgres;Port=5432;Database=vivid_imagination;Username=vivid_user;Password=ChangeThisSecurePassword123!
ConnectionStrings__Identity=Host=postgres;Port=5432;Database=vivid_imagination;Username=vivid_user;Password=ChangeThisSecurePassword123!
ConnectionStrings__Social=Host=postgres;Port=5432;Database=vivid_imagination;Username=vivid_user;Password=ChangeThisSecurePassword123!

# --- MongoDB Document Database ---
ConnectionStrings__Mongo=mongodb://mongodb:27017
MongoOptions__ConnectionString=mongodb://mongodb:27017
MongoOptions__DatabaseName=vivid_imagination
Media__ConnectionString=mongodb://mongodb:27017
Media__DatabaseName=vivid_imagination
Moderation__ConnectionString=mongodb://mongodb:27017
Moderation__DatabaseName=vivid_imagination
Feed__ConnectionString=mongodb://mongodb:27017
Feed__DatabaseName=vivid_imagination

# --- Redis Distributed Cache ---
ConnectionStrings__Redis=redis:6379
ApplicationSettings__Cache__ConnectionString=redis:6379

# --- RabbitMQ Modular Event Bus ---
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RabbitMQ__Enabled=true
RabbitMQ__Host=rabbitmq
RabbitMQ__Username=guest
RabbitMQ__Password=guest
ApplicationSettings__EventBus__RabbitMQ__Host=rabbitmq
ApplicationSettings__EventBus__RabbitMQ__Username=guest
ApplicationSettings__EventBus__RabbitMQ__Password=guest

# --- AWS S3 Storage & AI Rekognition ---
AWS__Region=us-east-1
AWS__Bucket=vivid-photos-account-region
ApplicationSettings__General__PublicBucket=vivid-photos-account-region
ApplicationSettings__General__StorageType=S3

# --- Application Security & Auth Settings ---
ApplicationSettings__General__SecretKey=vivid-imagination-prod-jwt-secret-key-at-least-32-chars!
ApplicationSettings__General__EncryptionKey=vivid-imagination-prod-encryption-key-32-chars!
ApplicationSettings__OpenIdConnectSettings__Authority=https://api.yourdomain.com
ApplicationSettings__OpenIdConnectSettings__IssuerUri=https://api.yourdomain.com

# --- GitHub Container Registry Credentials (used by deploy-app) ---
GHCR_USERNAME=your-github-username
GHCR_TOKEN=ghp_yourTokenWithReadPackagesScope
