# ==============================================================================
# Vivid Imagination - Environment Configuration Template
# Copy to .env for local or production deployment:
#   cp infra/.env.example infra/.env
# ==============================================================================

# --- Docker Compose & Container Registry ---
API_IMAGE=ghcr.io/your-username/vividimagination.backend.api
APP_TAG=latest
GHCR_USERNAME=your-github-username
GHCR_TOKEN=ghp_yourTokenWithReadPackagesScope
POSTGRES_USER=postgres
POSTGRES_PASSWORD=mysecretpassword
POSTGRES_DB=vivid_imagination
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Logging
Logging__LogLevel__Default=Debug
Logging__LogLevel__Microsoft_AspNetCore=Debug
Logging__LogLevel__Microsoft_EntityFrameworkCore=Debug
Logging__LogLevel__MassTransit=Debug
Logging__LogLevel__OpenIddict=Debug

LoggingOptions__LogLevel__Default=Debug
LoggingOptions__LogLevel__Microsoft=Debug
LoggingOptions__LogLevel__Microsoft_Hosting_Lifetime=Debug
LoggingOptions__LogLevel__System=Debug

# Host
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080
ASPNETCORE_HTTP_PORTS=8080
AllowedHosts=*

# PostgreSQL
ConnectionStrings__Postgres=Host=postgres;Port=5432;Database=vivid_imagination;Username=postgres;Password=mysecretpassword;Include Error Detail=true
ConnectionStrings__Identity=Host=postgres;Port=5432;Database=vivid_imagination;Username=postgres;Password=mysecretpassword;Include Error Detail=true
ConnectionStrings__Social=Host=postgres;Port=5432;Database=vivid_imagination;Username=postgres;Password=mysecretpassword;Include Error Detail=true
Identity__ConnectionString=Host=postgres;Port=5432;Database=vivid_imagination;Username=postgres;Password=mysecretpassword;Include Error Detail=true
Social__ConnectionString=Host=postgres;Port=5432;Database=vivid_imagination;Username=postgres;Password=mysecretpassword;Include Error Detail=true

# MongoDB
ConnectionStrings__Mongo=mongodb://mongodb:27017
ConnectionStrings__Media=mongodb://mongodb:27017
ConnectionStrings__Moderation=mongodb://mongodb:27017
ConnectionStrings__Feed=mongodb://mongodb:27017
# Media module
Media__MongoOptions__ConnectionString=mongodb://mongodb:27017
Media__MongoOptions__DatabaseName=vivid_imagination_media

# Moderation module
Moderation__MongoOptions__ConnectionString=mongodb://mongodb:27017
Moderation__MongoOptions__DatabaseName=vivid_imagination_moderation

# Feed module
Feed__MongoOptions__ConnectionString=mongodb://mongodb:27017
Feed__MongoOptions__DatabaseName=vivid_imagination_feed

MongoOptions__ConnectionString=mongodb://mongodb:27017
MongoOptions__DatabaseName=vivid_imagination
MongoOptions__InitializeIndexes=true

# Redis
ConnectionStrings__Redis=redis:6379
ApplicationSettings__Cache__EnableDistributedCache=true
ApplicationSettings__Cache__DistributedCache=Redis
ApplicationSettings__Cache__ConnectionString=redis:6379
ApplicationSettings__Cache__DefaultCacheTime=60
ApplicationSettings__Cache__ShortTermCacheTime=5

# Database migrations
Database__ApplyMigrations=true

# Jobs
ClearCacheJob=0 0/15 * * * ?
Cron__UsePersistentStore=false
Cron__ConnectionStringName=Postgres

# AWS
AWS__Region=eu-west-1
AWS__Bucket=vivid-imagination-photos

# Application settings
ApplicationSettings__General__AppName=VividImagination
ApplicationSettings__General__DefaultTimeZoneId=UTC
ApplicationSettings__General__AllowUsersToSetTimeZone=true
ApplicationSettings__General__DefaultAuthProvider=OpenIdConnect
ApplicationSettings__General__MessageBrokerType=RabbitMq
ApplicationSettings__General__StorageType=Local
ApplicationSettings__General__MaxFileSizeInMb=15
ApplicationSettings__General__PublicBucket=vivid-imagination-photos
ApplicationSettings__General__DefaultClientUrl=http://localhost:3000
ApplicationSettings__General__DefaultLogoUrl=http://localhost:3000/logo.png
ApplicationSettings__General__DefaultActivationMode=Immediate
ApplicationSettings__General__EncryptionKey=change-me-32-character-minimum-key!
ApplicationSettings__General__SecretKey=change-me-32-character-minimum-secret!

# Images
ApplicationSettings__Images__MaxFileSizeInMb=15
ApplicationSettings__Images__MaximumImageSize=4096
ApplicationSettings__Images__DefaultImageQuality=85

# CORS
ApplicationSettings__CORS__AllowAnyOrigin=true
ApplicationSettings__CORS__AllowedOrigins__0=http://localhost:3000
ApplicationSettings__CORS__AllowedOrigins__1=http://localhost:5000
ApplicationSettings__CORS__AllowedOrigins__2=https://localhost:7001

# Local storage
ApplicationSettings__Storage__Local__Path=/app/App_Data/Storage
ApplicationSettings__Storage__S3__BucketName=vivid-photos-438777519570-eu-west-1
ApplicationSettings__Storage__S3__Region=eu-west-1

# Security
ApplicationSettings__SecuritySettings__PasswordMinimumLength=8
ApplicationSettings__SecuritySettings__PasswordRequireUppercase=true
ApplicationSettings__SecuritySettings__PasswordRequireLowercase=true
ApplicationSettings__SecuritySettings__PasswordRequireNonAlphanumeric=true
ApplicationSettings__SecuritySettings__PasswordRequireDigit=true
ApplicationSettings__SecuritySettings__FailedPasswordAllowedAttempts=5
ApplicationSettings__SecuritySettings__FailedPasswordLockoutMinutes=15
ApplicationSettings__SecuritySettings__RequireUniqueEmail=true

# OpenID Connect
ApplicationSettings__OpenIdConnectSettings__Authority=https://localhost:7001
ApplicationSettings__OpenIdConnectSettings__Audiences__0=vivid-imagination-api
ApplicationSettings__OpenIdConnectSettings__IssuerUri=https://localhost:7001
ApplicationSettings__OpenIdConnectSettings__DefaultClientSecret=change-me
ApplicationSettings__OpenIdConnectSettings__EnableValidation=false

# Data protection
ApplicationSettings__DataProtectionSettings__Storage=Local
ApplicationSettings__DataProtectionSettings__LocalKeysPath=/app/App_Data/DataProtection

# RabbitMQ
RabbitMQ__Enabled=true
RabbitMQ__Host=rabbitmq://rabbitmq
ApplicationSettings__EventBus__RabbitMQ__Host=rabbitmq://rabbitmq
ApplicationSettings__EventBus__RabbitMQ__Username=guest
ApplicationSettings__EventBus__RabbitMQ__Password=guest
ApplicationSettings__EventBus__RabbitMQ__UseSsl=false

# SQS
ApplicationSettings__EventBus__SQS__Region=eu-west-1
ApplicationSettings__EventBus__SQS__UseInstanceProfile=false

# HTTP
ApplicationSettings__Http__ForwardedHttpHeader=X-Forwarded-For
ApplicationSettings__Http__UseHttpClusterHttps=false
ApplicationSettings__Http__UseHttpXForwardedProto=false
ApplicationSettings__Http__UseInstanceProfile=false

# JWT
ApplicationSettings__Jwt__AccessTokenLifetime=60
ApplicationSettings__Jwt__RefreshTokenLifetime=14
