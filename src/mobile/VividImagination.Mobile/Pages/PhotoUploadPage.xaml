<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:VividImagination.Mobile.ViewModels"
             xmlns:controls="clr-namespace:VividImagination.Mobile.Pages.Controls"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="VividImagination.Mobile.Pages.PhotoUploadPage"
             x:DataType="vm:PhotoUploadViewModel"
             Title="New photo"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource AppBackground}">

    <controls:ResponsiveContainer ActiveTab="Upload">
        <Grid RowDefinitions="Auto,*"
              HorizontalOptions="Fill"
              VerticalOptions="Fill">

            <!-- Header: 'New photo' -->
            <Grid Grid.Row="0"
                  BackgroundColor="#E60D0B0A"
                  Padding="20,16,20,12"
                  ZIndex="10">
                <Label Text="New photo"
                       FontFamily="SyneBold"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextPrimary}" />
                <BoxView HeightRequest="1"
                         Color="{StaticResource BorderGlow}"
                         VerticalOptions="End" />
            </Grid>

            <!-- Form Body -->
            <ScrollView Grid.Row="1" Margin="0,0,0,72">
                <VerticalStackLayout Spacing="20" Padding="20">

                    <!-- Big Dashed Square: 'Tap to choose a photo' with format & size limits -->
                    <Border StrokeShape="RoundRectangle 24"
                            Stroke="{StaticResource BorderGlow}"
                            StrokeThickness="2"
                            StrokeDashArray="4,4"
                            BackgroundColor="{StaticResource AppSurface}"
                            HeightRequest="280"
                            WidthRequest="280"
                            HorizontalOptions="Center"
                            Padding="0">

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding PickPhotoCommand}" />
                        </Border.GestureRecognizers>

                        <Grid>
                            <!-- Unselected Prompt -->
                            <VerticalStackLayout VerticalOptions="Center"
                                                 HorizontalOptions="Center"
                                                 Spacing="12"
                                                 Padding="20"
                                                 IsVisible="{Binding HasSelectedPhoto, Converter={toolkit:InvertedBoolConverter}}">
                                <Image Source="pick_image.png"
                                       WidthRequest="44"
                                       HeightRequest="44"
                                       HorizontalOptions="Center">
                                    <Image.Behaviors>
                                        <toolkit:IconTintColorBehavior TintColor="{StaticResource AccentVermilion}" />
                                    </Image.Behaviors>
                                </Image>

                                <Label Text="Tap to choose a photo"
                                       FontFamily="SyneBold"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}"
                                       HorizontalTextAlignment="Center" />

                                <Label Text="JPEG, PNG and WebP up to 15 MB"
                                       FontFamily="ManropeRegular"
                                       FontSize="12"
                                       TextColor="{StaticResource TextMuted}"
                                       HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>

                            <!-- Preview filling the square -->
                            <Grid IsVisible="{Binding HasSelectedPhoto}">
                                <Image Source="{Binding PreviewImage}"
                                       Aspect="AspectFill"
                                       HorizontalOptions="Fill"
                                       VerticalOptions="Fill" />

                                <!-- Overlay Tap Hint -->
                                <Border BackgroundColor="#990D0B0A"
                                        StrokeShape="RoundRectangle 9999"
                                        HorizontalOptions="End"
                                        VerticalOptions="Start"
                                        Margin="12"
                                        Padding="12,6">
                                    <Label Text="Tap to change"
                                           FontFamily="ManropeSemiBold"
                                           FontSize="11"
                                           TextColor="{StaticResource TextPrimary}" />
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Caption Box with Live 0/500 Counter -->
                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Text="Caption"
                                   FontFamily="ManropeSemiBold"
                                   FontSize="13"
                                   TextColor="{StaticResource TextMuted}" />

                            <!-- Live Character Counter -->
                            <Label Grid.Column="1"
                                   Text="{Binding CaptionLength, StringFormat='{0}/500'}"
                                   FontFamily="ManropeRegular"
                                   FontSize="12"
                                   TextColor="{StaticResource TextMuted}" />
                        </Grid>

                        <Border StrokeShape="RoundRectangle 16"
                                Stroke="{StaticResource BorderGlow}"
                                StrokeThickness="1"
                                BackgroundColor="{StaticResource AppSurface}"
                                Padding="14,10">
                            <Editor Text="{Binding Caption}"
                                    FontFamily="ManropeRegular"
                                    Placeholder="Write a story or description about this photo..."
                                    PlaceholderColor="{StaticResource TextMuted}"
                                    TextColor="{StaticResource TextPrimary}"
                                    HeightRequest="90"
                                    MaxLength="500" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Tags Field -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Tags"
                               FontFamily="ManropeSemiBold"
                               FontSize="13"
                               TextColor="{StaticResource TextMuted}" />
                        <Border StrokeShape="RoundRectangle 16"
                                Stroke="{StaticResource BorderGlow}"
                                StrokeThickness="1"
                                BackgroundColor="{StaticResource AppSurface}"
                                Padding="14,0">
                            <Entry Text="{Binding Tags}"
                                   FontFamily="ManropeRegular"
                                   Placeholder="e.g. #nature #sunset #serenity"
                                   PlaceholderColor="{StaticResource TextMuted}"
                                   TextColor="{StaticResource TextPrimary}" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Full-Height Orange Post Button (56px) with dynamic state transitions -->
                    <Button Text="{Binding PostButtonText}"
                            Command="{Binding UploadCommand}"
                            IsEnabled="{Binding IsUploading, Converter={toolkit:InvertedBoolConverter}}"
                            BackgroundColor="{StaticResource AccentVermilion}"
                            TextColor="White"
                            FontFamily="SyneBold"
                            FontSize="16"
                            CornerRadius="28"
                            HeightRequest="56"
                            Margin="0,8,0,24">
                        <Button.Shadow>
                            <Shadow Brush="{StaticResource AccentVermilion}" Offset="0,4" Radius="16" Opacity="0.4" />
                        </Button.Shadow>
                    </Button>

                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </controls:ResponsiveContainer>

</ContentPage>
