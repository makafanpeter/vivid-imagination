<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:VividImagination.Mobile.ViewModels"
             xmlns:controls="clr-namespace:VividImagination.Mobile.Pages.Controls"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="VividImagination.Mobile.Pages.LoginPage"
             x:DataType="vm:LoginViewModel"
             Title="Sign In"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource AppBackground}">

    <controls:ResponsiveContainer ShowBottomNav="False">
        <Grid HorizontalOptions="Fill" VerticalOptions="Fill">

            <!-- Radial glow background -->
            <Grid.Background>
                <RadialGradientBrush Center="0.5,0.08" Radius="0.85">
                    <GradientStop Color="#33FF551C" Offset="0.0" />
                    <GradientStop Color="#000D0B0A" Offset="0.75" />
                </RadialGradientBrush>
            </Grid.Background>

            <ScrollView HorizontalOptions="Fill" VerticalOptions="Fill">
                <VerticalStackLayout Spacing="20"
                                     Padding="24,36"
                                     VerticalOptions="Center"
                                     HorizontalOptions="Fill">

                    <!-- Header Wordmark with Hot Orange Dot -->
                    <Label HorizontalOptions="Center">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Vivid"
                                      FontFamily="SyneBold"
                                      FontSize="32"
                                      FontAttributes="Bold"
                                      TextColor="{StaticResource TextPrimary}" />
                                <Span Text="."
                                      FontFamily="SyneBold"
                                      FontSize="32"
                                      FontAttributes="Bold"
                                      TextColor="{StaticResource AccentVermilion}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <!-- Headline & Subtitle -->
                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                        <Label Text="See the world more vividly."
                               FontFamily="SyneBold"
                               FontSize="20"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"
                               TextColor="{StaticResource TextPrimary}" />

                        <Label Text="Authentic, freshly moderated photography."
                               FontFamily="ManropeRegular"
                               FontSize="13"
                               TextColor="{StaticResource TextSecondary}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>

                    <!-- Segmented Mode Switcher: Sign In | Register -->
                    <Border StrokeShape="RoundRectangle 20"
                            Stroke="{StaticResource BorderGlow}"
                            StrokeThickness="1"
                            BackgroundColor="{StaticResource AppSurfaceElevated}"
                            Padding="3"
                            HeightRequest="42"
                            Margin="0,4,0,4">
                        <Grid ColumnDefinitions="*,*">
                            <!-- Sign In Tab -->
                            <Button Grid.Column="0"
                                    Text="Sign In"
                                    Command="{Binding SetSignInModeCommand}"
                                    CornerRadius="17"
                                    FontFamily="ManropeSemiBold"
                                    FontSize="13"
                                    HeightRequest="36"
                                    Padding="0"
                                    BackgroundColor="{StaticResource AccentVermilion}"
                                    TextColor="White">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsRegisterMode}" Value="True">
                                        <Setter Property="BackgroundColor" Value="Transparent" />
                                        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>

                            <!-- Register Tab -->
                            <Button Grid.Column="1"
                                    Text="Register"
                                    Command="{Binding SetRegisterModeCommand}"
                                    CornerRadius="17"
                                    FontFamily="ManropeSemiBold"
                                    FontSize="13"
                                    HeightRequest="36"
                                    Padding="0"
                                    BackgroundColor="Transparent"
                                    TextColor="{StaticResource TextSecondary}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsRegisterMode}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource AccentVermilion}" />
                                        <Setter Property="TextColor" Value="White" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Error Banner if any -->
                    <Border IsVisible="{Binding ErrorMessage, Converter={toolkit:IsNotNullConverter}}"
                            BackgroundColor="#2A1616"
                            Stroke="{StaticResource DestructiveRed}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 16"
                            Padding="14,10">
                        <Label Text="{Binding ErrorMessage}"
                               FontFamily="ManropeRegular"
                               TextColor="{StaticResource DestructiveRed}"
                               FontSize="13"
                               HorizontalTextAlignment="Center" />
                    </Border>

                    <!-- ================= SIGN IN FORM ================= -->
                    <VerticalStackLayout Spacing="16"
                                         IsVisible="{Binding IsRegisterMode, Converter={toolkit:InvertedBoolConverter}}">

                        <!-- Email or Username Field -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Email or Username"
                                   FontFamily="ManropeSemiBold"
                                   FontSize="12"
                                   TextColor="{StaticResource TextSecondary}" />

                            <Border StrokeShape="RoundRectangle 16"
                                    Stroke="{StaticResource BorderGlow}"
                                    StrokeThickness="1"
                                    BackgroundColor="{StaticResource AppSurface}"
                                    Padding="14,0"
                                    HeightRequest="48">
                                <Entry Text="{Binding UsernameOrEmail}"
                                       Placeholder="name@example.com or username"
                                       PlaceholderColor="{StaticResource TextMuted}"
                                       TextColor="{StaticResource TextPrimary}"
                                       FontFamily="ManropeRegular"
                                       FontSize="14"
                                       VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Password Field -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Password"
                                   FontFamily="ManropeSemiBold"
                                   FontSize="12"
                                   TextColor="{StaticResource TextSecondary}" />

                            <Border StrokeShape="RoundRectangle 16"
                                    Stroke="{StaticResource BorderGlow}"
                                    StrokeThickness="1"
                                    BackgroundColor="{StaticResource AppSurface}"
                                    Padding="14,0"
                                    HeightRequest="48">
                                <Entry Text="{Binding Password}"
                                       IsPassword="True"
                                       Placeholder="Enter your password"
                                       PlaceholderColor="{StaticResource TextMuted}"
                                       TextColor="{StaticResource TextPrimary}"
                                       FontFamily="ManropeRegular"
                                       FontSize="14"
                                       VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Sign In Button -->
                        <Button Text="Sign In"
                                Command="{Binding LoginCommand}"
                                IsEnabled="{Binding IsBusy, Converter={toolkit:InvertedBoolConverter}}"
                                BackgroundColor="{StaticResource AccentVermilion}"
                                TextColor="White"
                                FontFamily="ManropeBold"
                                FontSize="15"
                                CornerRadius="24"
                                HeightRequest="50"
                                Margin="0,4,0,0">
                            <Button.Shadow>
                                <Shadow Brush="{StaticResource AccentVermilion}" Offset="0,3" Radius="8" Opacity="0.3" />
                            </Button.Shadow>
                        </Button>

                        <!-- Switch to Register Link -->
                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="4" Margin="0,6,0,0">
                            <Label Text="Don't have an account?"
                                   FontFamily="ManropeRegular"
                                   FontSize="13"
                                   TextColor="{StaticResource TextSecondary}"
                                   VerticalOptions="Center" />
                            <Label Text="Register"
                                   FontFamily="ManropeBold"
                                   FontSize="13"
                                   TextColor="{StaticResource AccentVermilion}"
                                   VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SetRegisterModeCommand}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </HorizontalStackLayout>

                    </VerticalStackLayout>

                    <!-- ================= REGISTER FORM ================= -->
                    <VerticalStackLayout Spacing="16"
                                         IsVisible="{Binding IsRegisterMode}">

                        <!-- Full Name Field -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Full Name"
                                   FontFamily="ManropeSemiBold"
                                   FontSize="12"
                                   TextColor="{StaticResource TextSecondary}" />

                            <Border StrokeShape="RoundRectangle 16"
                                    Stroke="{StaticResource BorderGlow}"
                                    StrokeThickness="1"
                                    BackgroundColor="{StaticResource AppSurface}"
                                    Padding="14,0"
                                    HeightRequest="48">
                                <Entry Text="{Binding FullName}"
                                       Placeholder="e.g. Alex Morgan"
                                       PlaceholderColor="{StaticResource TextMuted}"
                                       TextColor="{StaticResource TextPrimary}"
                                       FontFamily="ManropeRegular"
                                       FontSize="14"
                                       VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Email Address Field -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Email Address"
                                   FontFamily="ManropeSemiBold"
                                   FontSize="12"
                                   TextColor="{StaticResource TextSecondary}" />

                            <Border StrokeShape="RoundRectangle 16"
                                    Stroke="{StaticResource BorderGlow}"
                                    StrokeThickness="1"
                                    BackgroundColor="{StaticResource AppSurface}"
                                    Padding="14,0"
                                    HeightRequest="48">
                                <Entry Text="{Binding UsernameOrEmail}"
                                       Keyboard="Email"
                                       Placeholder="name@example.com"
                                       PlaceholderColor="{StaticResource TextMuted}"
                                       TextColor="{StaticResource TextPrimary}"
                                       FontFamily="ManropeRegular"
                                       FontSize="14"
                                       VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Password Field -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Password"
                                   FontFamily="ManropeSemiBold"
                                   FontSize="12"
                                   TextColor="{StaticResource TextSecondary}" />

                            <Border StrokeShape="RoundRectangle 16"
                                    Stroke="{StaticResource BorderGlow}"
                                    StrokeThickness="1"
                                    BackgroundColor="{StaticResource AppSurface}"
                                    Padding="14,0"
                                    HeightRequest="48">
                                <Entry Text="{Binding Password}"
                                       IsPassword="True"
                                       Placeholder="Min 8 chars, 1 uppercase, 1 digit, 1 symbol"
                                       PlaceholderColor="{StaticResource TextMuted}"
                                       TextColor="{StaticResource TextPrimary}"
                                       FontFamily="ManropeRegular"
                                       FontSize="13"
                                       VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Confirm Password Field -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Confirm Password"
                                   FontFamily="ManropeSemiBold"
                                   FontSize="12"
                                   TextColor="{StaticResource TextSecondary}" />

                            <Border StrokeShape="RoundRectangle 16"
                                    Stroke="{StaticResource BorderGlow}"
                                    StrokeThickness="1"
                                    BackgroundColor="{StaticResource AppSurface}"
                                    Padding="14,0"
                                    HeightRequest="48">
                                <Entry Text="{Binding ConfirmPassword}"
                                       IsPassword="True"
                                       Placeholder="Re-enter your password"
                                       PlaceholderColor="{StaticResource TextMuted}"
                                       TextColor="{StaticResource TextPrimary}"
                                       FontFamily="ManropeRegular"
                                       FontSize="13"
                                       VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Create Account Button -->
                        <Button Text="Create Account"
                                Command="{Binding RegisterCommand}"
                                IsEnabled="{Binding IsBusy, Converter={toolkit:InvertedBoolConverter}}"
                                BackgroundColor="{StaticResource AccentVermilion}"
                                TextColor="White"
                                FontFamily="ManropeBold"
                                FontSize="15"
                                CornerRadius="24"
                                HeightRequest="50"
                                Margin="0,4,0,0">
                            <Button.Shadow>
                                <Shadow Brush="{StaticResource AccentVermilion}" Offset="0,3" Radius="8" Opacity="0.3" />
                            </Button.Shadow>
                        </Button>

                        <!-- Switch to Sign In Link -->
                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="4" Margin="0,6,0,0">
                            <Label Text="Already have an account?"
                                   FontFamily="ManropeRegular"
                                   FontSize="13"
                                   TextColor="{StaticResource TextSecondary}"
                                   VerticalOptions="Center" />
                            <Label Text="Sign In"
                                   FontFamily="ManropeBold"
                                   FontSize="13"
                                   TextColor="{StaticResource AccentVermilion}"
                                   VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SetSignInModeCommand}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </HorizontalStackLayout>

                    </VerticalStackLayout>

                    <!-- Busy Indicator -->
                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                       IsVisible="{Binding IsBusy}"
                                       Color="{StaticResource AccentVermilion}"
                                       HeightRequest="36"
                                       WidthRequest="36"
                                       HorizontalOptions="Center" />

                    <!-- Guest Browsing Link -->
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center" Margin="0,10,0,0">
                        <Label Text="Browsing is free without an account."
                               FontFamily="ManropeRegular"
                               FontSize="12"
                               TextColor="{StaticResource TextMuted}"
                               HorizontalTextAlignment="Center" />

                        <Button Text="Continue Browsing Feed →"
                                Command="{Binding BrowseAsGuestCommand}"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource AccentVermilion}"
                                FontFamily="ManropeSemiBold"
                                FontSize="13"
                                HeightRequest="36" />
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </controls:ResponsiveContainer>

</ContentPage>
