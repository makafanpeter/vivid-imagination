<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:VividImagination.Mobile.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="VividImagination.Mobile.Pages.Controls.BlurShieldView"
             x:DataType="vm:FeedItemViewModel">

    <!-- Edge-to-edge photo container (no frame or padding) -->
    <Grid HeightRequest="380" HorizontalOptions="Fill" IsClippedToBounds="True">

        <!-- Main Photo: Loaded edge-to-edge -->
        <Image Source="{Binding ImageUrl}"
               Aspect="AspectFill"
               HorizontalOptions="Fill"
               VerticalOptions="Fill" />

        <!-- Sensitive Cover Layer: Scaled up slightly with hard blur & dark translucent layer -->
        <Grid x:Name="ShieldOverlay"
              IsVisible="{Binding IsShieldActive}"
              HorizontalOptions="Fill"
              VerticalOptions="Fill">

            <!-- High-blur placeholder canvas scaled up slightly -->
            <Image Source="{Binding BlurHashImageSource}"
                   Aspect="AspectFill"
                   Scale="1.08"
                   HorizontalOptions="Fill"
                   VerticalOptions="Fill" />

            <!-- Dark Translucent Layer with Frosted Blur Effect -->
            <BoxView Color="#E60D0B0A"
                     HorizontalOptions="Fill"
                     VerticalOptions="Fill" />

            <!-- Warning Information & Show Content Pill -->
            <VerticalStackLayout VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Spacing="12"
                                 Padding="24">

                <!-- Amber Eye-Off Icon -->
                <Border StrokeShape="RoundRectangle 24"
                        BackgroundColor="#26F59E0B"
                        Stroke="{StaticResource WarningAmber}"
                        StrokeThickness="1"
                        HorizontalOptions="Center"
                        HeightRequest="52"
                        WidthRequest="52">
                    <Label Text="👁️‍🗨️"
                           FontSize="24"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <!-- Words 'Sensitive content' in Warning Amber -->
                <Label Text="Sensitive content"
                       FontFamily="SyneBold"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="{StaticResource WarningAmber}"
                       HorizontalTextAlignment="Center" />

                <!-- Moderation Reason / Category -->
                <Label Text="{Binding SafetyCategory}"
                       FontFamily="ManropeRegular"
                       FontSize="13"
                       TextColor="{StaticResource TextMuted}"
                       HorizontalTextAlignment="Center"
                       IsVisible="{Binding SafetyCategory, Converter={toolkit:IsNotNullConverter}}" />

                <!-- Show Content Pill Button (500ms fade on click) -->
                <Button Text="Show Content"
                        Clicked="OnShowContentClicked"
                        BackgroundColor="{StaticResource AccentVermilion}"
                        TextColor="White"
                        FontFamily="ManropeSemiBold"
                        CornerRadius="22"
                        HeightRequest="44"
                        Padding="28,0"
                        Margin="0,8,0,0">
                    <Button.Shadow>
                        <Shadow Brush="{StaticResource AccentVermilion}" Offset="0,4" Radius="14" Opacity="0.4" />
                    </Button.Shadow>
                </Button>
            </VerticalStackLayout>
        </Grid>
    </Grid>

</ContentView>