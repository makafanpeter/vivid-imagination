<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:VividImagination.Mobile.ViewModels"
             xmlns:controls="clr-namespace:VividImagination.Mobile.Pages.Controls"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="VividImagination.Mobile.Pages.Controls.FeedItemCard"
             x:DataType="vm:FeedItemViewModel">

    <!-- Edge-to-edge card with no frame or padding around the image -->
    <VerticalStackLayout Spacing="10" Margin="0,0,0,28">

        <!-- 1. The image: Full width, edge-to-edge, with sensitive cover if needed -->
        <controls:BlurShieldView BindingContext="{Binding .}" />

        <!-- 3. The action row under the image -->
        <Grid ColumnDefinitions="Auto,*,Auto"
              Padding="14,0,14,0"
              VerticalOptions="Center">

            <!-- Vote Pill: Rounded grey capsule holding up arrow, net score, and down arrow -->
            <Border Grid.Column="0"
                    StrokeShape="RoundRectangle 9999"
                    Stroke="{StaticResource BorderGlow}"
                    StrokeThickness="1"
                    BackgroundColor="{StaticResource AppSurfaceElevated}"
                    HeightRequest="40"
                    Padding="10,0"
                    VerticalOptions="Start">

                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                    <!-- Up Arrow -->
                    <Label Text="{Binding UpvoteGlyph}"
                           FontFamily="ManropeBold"
                           FontSize="14"
                           TextColor="{Binding IsUpvoted, Converter={StaticResource AccentVermilionOrMutedConverter}}"
                           VerticalOptions="Center"
                           Padding="4,6">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding UpvoteCommand}" />
                        </Label.GestureRecognizers>
                    </Label>

                    <!-- Score (Upvotes - Downvotes) -->
                    <Label Text="{Binding NetScore}"
                           FontFamily="ManropeSemiBold"
                           FontSize="13"
                           TextColor="{StaticResource TextPrimary}"
                           VerticalOptions="Center" />

                    <!-- Down Arrow -->
                    <Label Text="{Binding DownvoteGlyph}"
                           FontFamily="ManropeBold"
                           FontSize="14"
                           TextColor="{Binding IsDownvoted, Converter={StaticResource DestructiveRedOrMutedConverter}}"
                           VerticalOptions="Center"
                           Padding="4,6">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding DownvoteCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>
            </Border>

            <!-- Caption beside it, with tags underneath in orange, each with a # -->
            <VerticalStackLayout Grid.Column="1"
                                 Margin="12,0,8,0"
                                 Spacing="3"
                                 VerticalOptions="Center">
                <!-- Caption: Wraps if long -->
                <Label Text="{Binding Caption}"
                       FontFamily="ManropeRegular"
                       FontSize="13"
                       TextColor="{StaticResource TextPrimary}"
                       LineBreakMode="WordWrap" />

                <!-- Tags: In hot orange vermilion, truncated with ellipsis on overflow -->
                <Label Text="{Binding TagsLine}"
                       FontFamily="ManropeSemiBold"
                       FontSize="12"
                       TextColor="{StaticResource AccentVermilion}"
                       LineBreakMode="TailTruncation"
                       MaxLines="1" />
            </VerticalStackLayout>

            <!-- Small flag on the far right to report -->
            <Border Grid.Column="2"
                    StrokeThickness="0"
                    BackgroundColor="Transparent"
                    VerticalOptions="Start"
                    Padding="6,8">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ReportCommand}" />
                </Border.GestureRecognizers>
                <Image Source="report_flag.png"
                       WidthRequest="18"
                       HeightRequest="18"
                       VerticalOptions="Center">
                    <Image.Behaviors>
                        <toolkit:IconTintColorBehavior TintColor="{StaticResource TextMuted}" />
                    </Image.Behaviors>
                </Image>
            </Border>
        </Grid>
    </VerticalStackLayout>

</ContentView>