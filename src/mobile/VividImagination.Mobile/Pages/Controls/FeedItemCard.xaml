<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:VividImagination.Mobile.ViewModels"
             xmlns:controls="clr-namespace:VividImagination.Mobile.Pages.Controls"
             x:Class="VividImagination.Mobile.Pages.Controls.FeedItemCard"
             x:DataType="vm:FeedItemViewModel">

    <Border StrokeThickness="1"
            Stroke="#22000000"
            StrokeShape="RoundRectangle 16"
            BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E24}"
            Margin="12,8"
            Padding="0">

        <VerticalStackLayout Spacing="0">
            <!-- Header: Creator & Options -->
            <Grid ColumnDefinitions="Auto,*,Auto"
                  Padding="14,12"
                  VerticalOptions="Center">

                <!-- Avatar Circle -->
                <Border Grid.Column="0"
                        WidthRequest="38"
                        HeightRequest="38"
                        StrokeShape="RoundRectangle 19"
                        BackgroundColor="#512BD4"
                        StrokeThickness="0">
                    <Label Text="👤"
                           FontSize="18"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <!-- Creator Name & Timestamp -->
                <VerticalStackLayout Grid.Column="1"
                                     Margin="10,0,0,0"
                                     VerticalOptions="Center">
                    <Label Text="Vivid Creator"
                           FontAttributes="Bold"
                           FontSize="14"
                           TextColor="{AppThemeBinding Light=#1F1F1F, Dark=White}" />
                    <Label Text="{Binding FormattedDate}"
                           FontSize="12"
                           TextColor="{AppThemeBinding Light=#757575, Dark=#A0A0A0}" />
                </VerticalStackLayout>

                <!-- Report Button -->
                <Button Grid.Column="2"
                        Text="🚩 Report"
                        FontSize="12"
                        TextColor="{AppThemeBinding Light=#D32F2F, Dark=#FF8A80}"
                        BackgroundColor="Transparent"
                        Padding="8,0"
                        HeightRequest="32"
                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:FeedViewModel}}, Path=ReportCommand}"
                        CommandParameter="{Binding .}" />
            </Grid>

            <!-- Media Section with Blur Shield -->
            <controls:BlurShieldView BindingContext="{Binding .}" />

            <!-- Social Action Bar -->
            <Grid ColumnDefinitions="Auto,Auto,*,Auto"
                  Padding="14,10,14,6"
                  VerticalOptions="Center">

                <!-- Upvote Button -->
                <Button Grid.Column="0"
                        Text="{Binding Upvotes, StringFormat='▲ {0}'}"
                        FontAttributes="Bold"
                        FontSize="13"
                        CornerRadius="18"
                        HeightRequest="36"
                        Padding="14,0"
                        Margin="0,0,8,0"
                        BackgroundColor="{AppThemeBinding Light=#F0EEFF, Dark=#2B2446}"
                        TextColor="#512BD4"
                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:FeedViewModel}}, Path=UpvoteCommand}"
                        CommandParameter="{Binding .}" />

                <!-- Downvote Button -->
                <Button Grid.Column="1"
                        Text="{Binding Downvotes, StringFormat='▼ {0}'}"
                        FontAttributes="Bold"
                        FontSize="13"
                        CornerRadius="18"
                        HeightRequest="36"
                        Padding="14,0"
                        BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2A2A2A}"
                        TextColor="{AppThemeBinding Light=#616161, Dark=#B0B0B0}"
                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:FeedViewModel}}, Path=DownvoteCommand}"
                        CommandParameter="{Binding .}" />

                <!-- Dynamic Rank Score -->
                <Border Grid.Column="3"
                        StrokeShape="RoundRectangle 12"
                        BackgroundColor="{AppThemeBinding Light=#F2F2F2, Dark=#2E2E38}"
                        StrokeThickness="0"
                        Padding="10,4"
                        VerticalOptions="Center">
                    <Label Text="{Binding FormattedScore}"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#424242, Dark=#E0E0E0}" />
                </Border>
            </Grid>

            <!-- Caption Area -->
            <Label Text="{Binding Caption}"
                   FontSize="14"
                   LineBreakMode="WordWrap"
                   TextColor="{AppThemeBinding Light=#242424, Dark=#E8E8E8}"
                   Padding="14,4,14,14" />
        </VerticalStackLayout>
    </Border>

</ContentView>
