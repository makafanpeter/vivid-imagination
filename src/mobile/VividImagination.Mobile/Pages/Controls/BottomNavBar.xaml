<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:VividImagination.Mobile.Pages.Controls"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Name="BottomNavRoot"
             x:Class="VividImagination.Mobile.Pages.Controls.BottomNavBar">

    <Grid HeightRequest="68"
          BackgroundColor="#E60D0B0A"
          Padding="8,0">

        <!-- Top border glow stroke -->
        <BoxView HeightRequest="1"
                 Color="{StaticResource BorderGlow}"
                 VerticalOptions="Start"
                 HorizontalOptions="Fill" />

        <!-- Centered constrained nav cluster on wide panels; fills on mobile -->
        <Grid ColumnDefinitions="*, Auto, *"
              MaximumWidthRequest="420"
              HorizontalOptions="Center"
              VerticalOptions="Fill">

            <!-- Left Side: Feed -->
            <HorizontalStackLayout Grid.Column="0"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   Spacing="16">
                <VerticalStackLayout x:Name="FeedTabButton"
                                     Spacing="3"
                                     VerticalOptions="Center"
                                     Padding="12,6">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnFeedTapped" />
                    </VerticalStackLayout.GestureRecognizers>

                    <Image Source="feed_flame.png"
                           WidthRequest="22"
                           HeightRequest="22"
                           HorizontalOptions="Center">
                        <Image.Behaviors>
                            <toolkit:IconTintColorBehavior TintColor="{Binding FeedTextColor, Source={x:Reference BottomNavRoot}}" />
                        </Image.Behaviors>
                    </Image>

                    <Label Text="Feed"
                           FontFamily="ManropeSemiBold"
                           FontSize="11"
                           TextColor="{Binding FeedTextColor, Source={RelativeSource AncestorType={x:Type local:BottomNavBar}}}"
                           HorizontalOptions="Center" />

                    <BoxView WidthRequest="4"
                             HeightRequest="4"
                             CornerRadius="2"
                             Color="{StaticResource AccentVermilion}"
                             HorizontalOptions="Center"
                             IsVisible="{Binding IsFeedActive, Source={RelativeSource AncestorType={x:Type local:BottomNavBar}}}" />
                </VerticalStackLayout>
            </HorizontalStackLayout>

            <!-- Center: Distinct Raised Round Orange ＋ Button with reduced glow -->
            <Border Grid.Column="1"
                    WidthRequest="50"
                    HeightRequest="50"
                    StrokeShape="RoundRectangle 25"
                    BackgroundColor="{StaticResource AccentVermilion}"
                    Stroke="#33FFFFFF"
                    StrokeThickness="1"
                    Margin="0,-14,0,0"
                    VerticalOptions="Center"
                    HorizontalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnUploadTapped" />
                </Border.GestureRecognizers>

                <Border.Shadow>
                    <Shadow Brush="{StaticResource AccentVermilion}"
                            Offset="0,2"
                            Radius="6"
                            Opacity="0.25" />
                </Border.Shadow>

                <Image Source="upload_plus.png"
                       WidthRequest="22"
                       HeightRequest="22"
                       HorizontalOptions="Center"
                       VerticalOptions="Center">
                    <Image.Behaviors>
                        <toolkit:IconTintColorBehavior TintColor="White" />
                    </Image.Behaviors>
                </Image>
            </Border>

            <!-- Right Side: Review (if moderator) and Me -->
            <HorizontalStackLayout Grid.Column="2"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   Spacing="12">

                <!-- Review Tab (Moderators only) -->
                <VerticalStackLayout x:Name="ReviewTabButton"
                                     Spacing="3"
                                     VerticalOptions="Center"
                                     Padding="10,6"
                                     IsVisible="{Binding IsModerator, Source={RelativeSource AncestorType={x:Type local:BottomNavBar}}}">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnReviewTapped" />
                    </VerticalStackLayout.GestureRecognizers>

                    <Image Source="review_shield_check.png"
                           WidthRequest="22"
                           HeightRequest="22"
                           HorizontalOptions="Center">
                        <Image.Behaviors>
                            <toolkit:IconTintColorBehavior TintColor="{Binding ReviewTextColor, Source={x:Reference BottomNavRoot}}" />
                        </Image.Behaviors>
                    </Image>

                    <Label Text="Review"
                           FontFamily="ManropeSemiBold"
                           FontSize="11"
                           TextColor="{Binding ReviewTextColor, Source={RelativeSource AncestorType={x:Type local:BottomNavBar}}}"
                           HorizontalOptions="Center" />

                    <BoxView WidthRequest="4"
                             HeightRequest="4"
                             CornerRadius="2"
                             Color="{StaticResource AccentVermilion}"
                             HorizontalOptions="Center"
                             IsVisible="{Binding IsReviewActive, Source={RelativeSource AncestorType={x:Type local:BottomNavBar}}}" />
                </VerticalStackLayout>

                <!-- Me Tab -->
                <VerticalStackLayout x:Name="MeTabButton"
                                     Spacing="3"
                                     VerticalOptions="Center"
                                     Padding="12,6">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnProfileTapped" />
                    </VerticalStackLayout.GestureRecognizers>

                    <Image Source="profile_user.png"
                           WidthRequest="22"
                           HeightRequest="22"
                           HorizontalOptions="Center">
                        <Image.Behaviors>
                            <toolkit:IconTintColorBehavior TintColor="{Binding MeTextColor, Source={x:Reference BottomNavRoot}}" />
                        </Image.Behaviors>
                    </Image>

                    <Label Text="Me"
                           FontFamily="ManropeSemiBold"
                           FontSize="11"
                           TextColor="{Binding MeTextColor, Source={RelativeSource AncestorType={x:Type local:BottomNavBar}}}"
                           HorizontalOptions="Center" />

                    <BoxView WidthRequest="4"
                             HeightRequest="4"
                             CornerRadius="2"
                             Color="{StaticResource AccentVermilion}"
                             HorizontalOptions="Center"
                             IsVisible="{Binding IsMeActive, Source={RelativeSource AncestorType={x:Type local:BottomNavBar}}}" />
                </VerticalStackLayout>
            </HorizontalStackLayout>

        </Grid>
    </Grid>

</ContentView>
