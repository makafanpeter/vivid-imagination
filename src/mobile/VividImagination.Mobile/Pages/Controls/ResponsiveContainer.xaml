<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:VividImagination.Mobile.Pages.Controls"
             x:Class="VividImagination.Mobile.Pages.Controls.ResponsiveContainer">

    <ContentView.Content>
        <!-- Outermost background canvas -->
        <Grid BackgroundColor="{StaticResource AppBackground}"
              HorizontalOptions="Fill"
              VerticalOptions="Fill">

            <!-- Centered Responsive Column Frame -->
            <Border x:Name="ColumnFrame"
                    BackgroundColor="{StaticResource AppBackground}"
                    Stroke="{StaticResource BorderGlow}"
                    StrokeThickness="0"
                    Padding="0"
                    VerticalOptions="Fill"
                    HorizontalOptions="Fill">

                <Grid x:Name="ColumnContainer"
                      VerticalOptions="Fill"
                      HorizontalOptions="Fill">

                    <!-- Page Body Slot -->
                    <ContentView x:Name="PageBodyPresenter"
                                 HorizontalOptions="Fill"
                                 VerticalOptions="Fill" />

                    <!-- Pinned Frosted Bottom Navigation Bar -->
                    <controls:BottomNavBar x:Name="BottomNavControl"
                                           VerticalOptions="End"
                                           HorizontalOptions="Fill"
                                           ZIndex="20" />

                    <!-- Top Toast Overlay -->
                    <controls:TopToastView VerticalOptions="Start"
                                           HorizontalOptions="Fill"
                                           ZIndex="100" />
                </Grid>
            </Border>
        </Grid>
    </ContentView.Content>

</ContentView>
