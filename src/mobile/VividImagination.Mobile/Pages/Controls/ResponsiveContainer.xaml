<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:VividImagination.Mobile.Pages.Controls"
             x:Class="VividImagination.Mobile.Pages.Controls.ResponsiveContainer">

    <ContentView.Content>
        <!-- Root grid fills window client area edge-to-edge -->
        <Grid BackgroundColor="{StaticResource AppBackground}"
              HorizontalOptions="Fill"
              VerticalOptions="Fill">

            <!-- Page Body Slot (Fills 100% of window) -->
            <ContentView x:Name="PageBodyPresenter"
                         HorizontalOptions="Fill"
                         VerticalOptions="Fill" />

            <!-- Pinned Frosted Bottom Navigation Bar (Fills 100% width, docked to bottom) -->
            <controls:BottomNavBar x:Name="BottomNavControl"
                                   VerticalOptions="End"
                                   HorizontalOptions="Fill"
                                   ZIndex="20" />

            <!-- Top Toast Overlay -->
            <controls:TopToastView VerticalOptions="Start"
                                   HorizontalOptions="Fill"
                                   ZIndex="100" />
        </Grid>
    </ContentView.Content>

</ContentView>
