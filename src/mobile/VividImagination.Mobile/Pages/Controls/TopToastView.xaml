<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VividImagination.Mobile.Pages.Controls.TopToastView"
             InputTransparent="True"
             CascadeInputTransparent="True"
             HorizontalOptions="Fill"
             VerticalOptions="Start">

    <!-- Floating Top-Center Pill Toast -->
    <Border x:Name="ToastContainer"
            IsVisible="False"
            Opacity="0"
            HorizontalOptions="Center"
            VerticalOptions="Start"
            Margin="0,16,0,0"
            Stroke="{StaticResource BorderGlow}"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 9999"
            BackgroundColor="#F2161311"
            Padding="16,8">

        <Border.Shadow>
            <Shadow Brush="#000000" Offset="0,4" Radius="12" Opacity="0.6" />
        </Border.Shadow>

        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
            <Label x:Name="ToastIcon"
                   Text="✨"
                   FontSize="14"
                   VerticalOptions="Center" />
            <Label x:Name="ToastText"
                   Text=""
                   FontFamily="ManropeSemiBold"
                   FontSize="13"
                   TextColor="{StaticResource TextPrimary}"
                   VerticalOptions="Center" />
        </HorizontalStackLayout>
    </Border>

</ContentView>