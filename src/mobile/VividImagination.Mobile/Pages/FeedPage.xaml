<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:VividImagination.Mobile.ViewModels"
             xmlns:controls="clr-namespace:VividImagination.Mobile.Pages.Controls"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="VividImagination.Mobile.Pages.FeedPage"
             x:DataType="vm:FeedViewModel"
             Title="Vivid"
             BackgroundColor="{StaticResource AppBackground}">

    <!-- Phone-first geometry: Centered column with maximum width -->
    <Grid MaximumWidthRequest="450"
          HorizontalOptions="Center"
          RowDefinitions="Auto,*">

        <!-- Top Toast Notification System Overlay -->
        <controls:TopToastView Grid.RowSpan="2" ZIndex="100" />

        <!-- 1. Pinned Header: Stays pinned while scrolling, frosted translucent with orange top glow -->
        <Grid Grid.Row="0"
              ZIndex="10"
              BackgroundColor="#E60D0B0A"
              Padding="16,14,16,10">

            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#38FF551C" Offset="0.0" />
                    <GradientStop Color="#000D0B0A" Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>

            <VerticalStackLayout Spacing="3">
                <!-- 'Vivid.' in bold display type with the full stop picked out in orange -->
                <Label>
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Vivid"
                                  FontFamily="SyneBold"
                                  FontSize="26"
                                  FontAttributes="Bold"
                                  TextColor="{StaticResource TextPrimary}" />
                            <Span Text="."
                                  FontFamily="SyneBold"
                                  FontSize="26"
                                  FontAttributes="Bold"
                                  TextColor="{StaticResource AccentVermilion}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <!-- In small grey type: 'Ranked by the community, fresh every hour.' -->
                <Label Text="Ranked by the community, fresh every hour."
                       FontFamily="ManropeRegular"
                       FontSize="12"
                       TextColor="{StaticResource TextMuted}" />
            </VerticalStackLayout>

            <!-- Bottom glow border of the frosted header -->
            <BoxView HeightRequest="1"
                     Color="{StaticResource BorderGlow}"
                     VerticalOptions="End" />
        </Grid>

        <!-- Main Feed Area: Scrollable Photos Stream -->
        <Grid Grid.Row="1">

            <!-- 2. Loading State: Two grey portrait-shaped blocks that pulse in place (no spinner) -->
            <VerticalStackLayout x:Name="SkeletonView"
                                 IsVisible="{Binding IsBusy}"
                                 Spacing="20"
                                 Padding="0,16"
                                 ZIndex="5">
                <Border HeightRequest="360"
                        StrokeShape="RoundRectangle 20"
                        BackgroundColor="#1E1A18"
                        Stroke="{StaticResource BorderGlow}"
                        StrokeThickness="1"
                        Margin="14,0" />

                <Border HeightRequest="360"
                        StrokeShape="RoundRectangle 20"
                        BackgroundColor="#1E1A18"
                        Stroke="{StaticResource BorderGlow}"
                        StrokeThickness="1"
                        Margin="14,0" />
            </VerticalStackLayout>

            <!-- Scrolling Stream of Full-Width Photos -->
            <RefreshView IsRefreshing="{Binding IsRefreshing}"
                         Command="{Binding RefreshFeedCommand}"
                         RefreshColor="{StaticResource AccentVermilion}">

                <CollectionView ItemsSource="{Binding Items}"
                                RemainingItemsThreshold="3"
                                RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}"
                                ItemSizingStrategy="MeasureAllItems">

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:FeedItemViewModel">
                            <controls:FeedItemCard />
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <!-- 3. Empty State: Centred 'Nothing here yet' with 'Be the first to share a photo — tap the + below.' -->
                    <CollectionView.EmptyView>
                        <VerticalStackLayout HorizontalOptions="Center"
                                             VerticalOptions="Center"
                                             Spacing="14"
                                             Padding="32"
                                             IsVisible="{Binding IsBusy, Converter={toolkit:InvertedBoolConverter}}">
                            <Border StrokeShape="RoundRectangle 28"
                                    WidthRequest="64"
                                    HeightRequest="64"
                                    BackgroundColor="{StaticResource AppSurfaceElevated}"
                                    Stroke="{StaticResource BorderGlow}"
                                    StrokeThickness="1"
                                    HorizontalOptions="Center">
                                <Label Text="📷"
                                       FontSize="28"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>

                            <Label Text="Nothing here yet"
                                   FontFamily="SyneBold"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center"
                                   TextColor="{StaticResource TextPrimary}" />

                            <Label Text="Be the first to share a photo — tap the + below."
                                   FontFamily="ManropeRegular"
                                   FontSize="14"
                                   TextColor="{StaticResource TextMuted}"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <!-- Footer: Small 'Loading more…' while quietly fetching next 10 -->
                    <CollectionView.Footer>
                        <VerticalStackLayout IsVisible="{Binding IsLoadingMore}"
                                             Padding="0,12"
                                             HorizontalOptions="Center">
                            <Label Text="Loading more…"
                                   FontFamily="ManropeRegular"
                                   FontSize="12"
                                   TextColor="{StaticResource TextMuted}"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </CollectionView.Footer>
                </CollectionView>
            </RefreshView>
        </Grid>
    </Grid>

</ContentPage>