<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:VividImagination.Mobile.ViewModels"
             xmlns:controls="clr-namespace:VividImagination.Mobile.Pages.Controls"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="VividImagination.Mobile.Pages.ProfilePage"
             x:DataType="vm:ProfileViewModel"
             Title="Me"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource AppBackground}">

    <controls:ResponsiveContainer ActiveTab="Me">
        <Grid RowDefinitions="Auto,*"
              HorizontalOptions="Fill"
              VerticalOptions="Fill">

            <!-- 1. Header: Avatar, Name, Photo Count across the top with a Sign-out Icon -->
            <Grid Grid.Row="0"
                  BackgroundColor="#E60D0B0A"
                  Padding="20,16"
                  ColumnDefinitions="Auto,*,Auto"
                  HorizontalOptions="Fill"
                  VerticalOptions="Center"
                  ZIndex="10">

                <!-- Circular Avatar -->
                <Border Grid.Column="0"
                        StrokeShape="RoundRectangle 24"
                        WidthRequest="48"
                        HeightRequest="48"
                        BackgroundColor="{StaticResource AppSurfaceElevated}"
                        Stroke="{StaticResource BorderGlow}"
                        StrokeThickness="1"
                        VerticalOptions="Center">
                    <Image Source="profile_user.png"
                           WidthRequest="24"
                           HeightRequest="24"
                           HorizontalOptions="Center"
                           VerticalOptions="Center">
                        <Image.Behaviors>
                            <toolkit:IconTintColorBehavior TintColor="{StaticResource TextPrimary}" />
                        </Image.Behaviors>
                    </Image>
                </Border>

                <!-- Name & Photo Count -->
                <VerticalStackLayout Grid.Column="1"
                                     Margin="12,0,0,0"
                                     Spacing="2"
                                     VerticalOptions="Center">
                    <Label Text="{Binding DisplayName}"
                           FontFamily="SyneBold"
                           FontSize="17"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}" />

                    <Label Text="{Binding PhotoCountText}"
                           FontFamily="ManropeRegular"
                           FontSize="12"
                           TextColor="{StaticResource TextSecondary}" />
                </VerticalStackLayout>

                <!-- Sign-Out Icon Button -->
                <Border Grid.Column="2"
                        WidthRequest="40"
                        HeightRequest="40"
                        StrokeThickness="0"
                        BackgroundColor="Transparent"
                        VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding LogoutCommand}" />
                    </Border.GestureRecognizers>
                    <Image Source="sign_out.png"
                           WidthRequest="20"
                           HeightRequest="20"
                           HorizontalOptions="Center"
                           VerticalOptions="Center">
                        <Image.Behaviors>
                            <toolkit:IconTintColorBehavior TintColor="{StaticResource TextMuted}" />
                        </Image.Behaviors>
                    </Image>
                </Border>

                <BoxView HeightRequest="1"
                         Color="{StaticResource BorderGlow}"
                         VerticalOptions="End"
                         Grid.ColumnSpan="3" />
            </Grid>

            <!-- Body: Sensitive Content Card & 3-Column Square Grid -->
            <ScrollView Grid.Row="1"
                        Margin="0,0,0,72"
                        HorizontalOptions="Fill"
                        VerticalOptions="Fill">
                <VerticalStackLayout Spacing="20"
                                     Padding="20"
                                     HorizontalOptions="Fill">

                    <!-- 2. 'Sensitive content' Card with a Three-Option Control (Blur / Hide / Always show) -->
                    <Border StrokeShape="RoundRectangle 20"
                            Stroke="{StaticResource BorderGlow}"
                            StrokeThickness="1"
                            BackgroundColor="{StaticResource AppSurface}"
                            Padding="16,14">

                        <VerticalStackLayout Spacing="10">
                            <Label Text="Sensitive content"
                                   FontFamily="SyneBold"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}" />

                            <Label Text="Choose how AI-moderated sensitive photos appear in your feed:"
                                   FontFamily="ManropeRegular"
                                   FontSize="12"
                                   TextColor="{StaticResource TextMuted}" />

                            <!-- Three-Way Capsule Segmented Control -->
                            <Border StrokeShape="RoundRectangle 19"
                                    BackgroundColor="{StaticResource AppSurfaceElevated}"
                                    StrokeThickness="0"
                                    HeightRequest="38"
                                    Padding="3">
                                <Grid ColumnDefinitions="*,*,*"
                                      HeightRequest="32">

                                    <!-- Option 1: Blur Active Pill -->
                                    <Border Grid.Column="0"
                                            StrokeShape="RoundRectangle 16"
                                            StrokeThickness="0"
                                            BackgroundColor="{StaticResource AccentVermilion}"
                                            IsVisible="{Binding IsBlurSelected}" />

                                    <!-- Option 2: Hide Active Pill -->
                                    <Border Grid.Column="1"
                                            StrokeShape="RoundRectangle 16"
                                            StrokeThickness="0"
                                            BackgroundColor="{StaticResource AccentVermilion}"
                                            IsVisible="{Binding IsHideSelected}" />

                                    <!-- Option 3: Always Show Active Pill -->
                                    <Border Grid.Column="2"
                                            StrokeShape="RoundRectangle 16"
                                            StrokeThickness="0"
                                            BackgroundColor="{StaticResource AccentVermilion}"
                                            IsVisible="{Binding IsAlwaysShowSelected}" />

                                    <!-- Option 1: Blur Label -->
                                    <Label Grid.Column="0"
                                           Text="Blur"
                                           FontFamily="ManropeSemiBold"
                                           FontSize="12"
                                           TextColor="{Binding IsBlurSelected, Converter={StaticResource SelectedSegmentTextColorConverter}}"
                                           HorizontalOptions="Fill"
                                           VerticalOptions="Fill"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding SetSafeBrowsingModeCommand}" CommandParameter="0" />
                                        </Label.GestureRecognizers>
                                    </Label>

                                    <!-- Option 2: Hide Label -->
                                    <Label Grid.Column="1"
                                           Text="Hide"
                                           FontFamily="ManropeSemiBold"
                                           FontSize="12"
                                           TextColor="{Binding IsHideSelected, Converter={StaticResource SelectedSegmentTextColorConverter}}"
                                           HorizontalOptions="Fill"
                                           VerticalOptions="Fill"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding SetSafeBrowsingModeCommand}" CommandParameter="1" />
                                        </Label.GestureRecognizers>
                                    </Label>

                                    <!-- Option 3: Always Show Label -->
                                    <Label Grid.Column="2"
                                           Text="Always show"
                                           FontFamily="ManropeSemiBold"
                                           FontSize="12"
                                           TextColor="{Binding IsAlwaysShowSelected, Converter={StaticResource SelectedSegmentTextColorConverter}}"
                                           HorizontalOptions="Fill"
                                           VerticalOptions="Fill"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding SetSafeBrowsingModeCommand}" CommandParameter="2" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Unauthenticated Prompt -->
                    <Border StrokeShape="RoundRectangle 20"
                            Stroke="{StaticResource BorderGlow}"
                            StrokeThickness="1"
                            BackgroundColor="{StaticResource AppSurface}"
                            Padding="20"
                            IsVisible="{Binding IsAuthenticated, Converter={toolkit:InvertedBoolConverter}}">
                        <VerticalStackLayout Spacing="14" HorizontalOptions="Center">
                            <Label Text="Join Vivid Imagination"
                                   FontFamily="SyneBold"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center"
                                   TextColor="{StaticResource TextPrimary}" />
                            <Label Text="Sign in to post your photos, vote on community uploads, and customize safe browsing."
                                   FontFamily="ManropeRegular"
                                   FontSize="13"
                                   HorizontalTextAlignment="Center"
                                   TextColor="{StaticResource TextMuted}" />
                            <Button Text="Sign In to Your Account"
                                    Command="{Binding OpenLoginCommand}"
                                    BackgroundColor="{StaticResource AccentVermilion}"
                                    TextColor="White"
                                    FontFamily="ManropeBold"
                                    CornerRadius="24"
                                    HeightRequest="46"
                                    Padding="24,0" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- 3. Uploads Grid Section -->
                    <Grid ColumnDefinitions="*,Auto" Margin="4,4,4,0">
                        <Label Grid.Column="0"
                               Text="Your uploads"
                               FontFamily="SyneBold"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" />

                        <Label Grid.Column="1"
                               Text="{Binding PhotoCountText}"
                               FontFamily="ManropeRegular"
                               FontSize="12"
                               TextColor="{StaticResource TextMuted}"
                               VerticalOptions="Center" />
                    </Grid>

                    <!-- Empty Uploads State -->
                    <VerticalStackLayout HorizontalOptions="Center"
                                         Spacing="12"
                                         Padding="24"
                                         IsVisible="{Binding HasUploads, Converter={toolkit:InvertedBoolConverter}}">
                        <Border StrokeShape="RoundRectangle 24"
                                WidthRequest="52"
                                HeightRequest="52"
                                BackgroundColor="{StaticResource AppSurfaceElevated}"
                                Stroke="{StaticResource BorderGlow}"
                                StrokeThickness="1"
                                HorizontalOptions="Center">
                            <Image Source="pick_image.png"
                                   WidthRequest="24"
                                   HeightRequest="24"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center">
                                <Image.Behaviors>
                                    <toolkit:IconTintColorBehavior TintColor="{StaticResource TextPrimary}" />
                                </Image.Behaviors>
                            </Image>
                        </Border>
                        <Label Text="No photos uploaded yet"
                               FontFamily="SyneBold"
                               FontSize="16"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"
                               TextColor="{StaticResource TextPrimary}" />
                        <Label Text="Share your first photograph to showcase your work."
                               FontFamily="ManropeRegular"
                               FontSize="13"
                               HorizontalTextAlignment="Center"
                               TextColor="{StaticResource TextSecondary}" />
                        <Button Text="+ Upload photo"
                                Command="{Binding NavigateToUploadCommand}"
                                CornerRadius="21"
                                HeightRequest="42"
                                Padding="22,0"
                                Margin="0,4,0,0"
                                BackgroundColor="{StaticResource AccentVermilion}"
                                TextColor="White"
                                FontFamily="ManropeBold"
                                FontSize="13"
                                HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <!-- 3-Column Square Photo Grid -->
                    <CollectionView ItemsSource="{Binding UserUploads}">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout Orientation="Vertical"
                                             Span="3"
                                             HorizontalItemSpacing="6"
                                             VerticalItemSpacing="6" />
                        </CollectionView.ItemsLayout>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:UserUploadItemViewModel">
                                <!-- Square Photo Container with Aspect Ratio 1:1 -->
                                <Border StrokeShape="RoundRectangle 12"
                                        Stroke="{StaticResource BorderGlow}"
                                        StrokeThickness="1"
                                        BackgroundColor="{StaticResource AppSurface}"
                                        HeightRequest="130"
                                        Padding="0">

                                    <Grid>
                                        <!-- Photo Image filling the square -->
                                        <Image Source="{Binding PhotoSource}"
                                               Aspect="AspectFill"
                                               HorizontalOptions="Fill"
                                               VerticalOptions="Fill" />

                                        <!-- Top-Left Status Badge: Checking, Live, Sensitive (amber) or Removed (red) -->
                                        <Border HorizontalOptions="Start"
                                                VerticalOptions="Start"
                                                Margin="4"
                                                Padding="6,2"
                                                StrokeShape="RoundRectangle 6"
                                                BackgroundColor="#D90D0B0A"
                                                StrokeThickness="0">
                                            <Label Text="{Binding StatusText}"
                                                   FontFamily="ManropeBold"
                                                   FontSize="9"
                                                   TextColor="{Binding StatusColor}" />
                                        </Border>

                                        <!-- Action Overlay Bar over image with pencil and bin buttons -->
                                        <Grid VerticalOptions="End"
                                              BackgroundColor="#B30D0B0A"
                                              Padding="4,2"
                                              ColumnDefinitions="*,Auto,Auto">

                                            <!-- Caption Preview snippet -->
                                            <Label Grid.Column="0"
                                                   Text="{Binding Caption}"
                                                   FontFamily="ManropeRegular"
                                                   FontSize="9"
                                                   TextColor="{StaticResource TextPrimary}"
                                                   LineBreakMode="TailTruncation"
                                                   MaxLines="1"
                                                   VerticalOptions="Center" />

                                            <!-- Pencil Button: opens prompt to rewrite caption -->
                                            <Label Grid.Column="1"
                                                   Text="✏️"
                                                   FontSize="12"
                                                   Padding="4,2"
                                                   VerticalOptions="Center">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProfileViewModel}}, Path=EditCaptionCommand, x:DataType={x:Type vm:ProfileViewModel}}"
                                                                          CommandParameter="{Binding .}" />
                                                </Label.GestureRecognizers>
                                            </Label>

                                            <!-- Bin Button: confirms and deletes upload -->
                                            <Label Grid.Column="2"
                                                   Text="🗑️"
                                                   FontSize="12"
                                                   Padding="4,2"
                                                   VerticalOptions="Center">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProfileViewModel}}, Path=DeleteUploadCommand, x:DataType={x:Type vm:ProfileViewModel}}"
                                                                          CommandParameter="{Binding .}" />
                                                </Label.GestureRecognizers>
                                            </Label>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </controls:ResponsiveContainer>

</ContentPage>
