<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:VividImagination.Mobile.ViewModels"
             xmlns:controls="clr-namespace:VividImagination.Mobile.Pages.Controls"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="VividImagination.Mobile.Pages.ReviewQueuePage"
             x:DataType="vm:ReviewQueueViewModel"
             Title="Review"
             BackgroundColor="{StaticResource AppBackground}">

    <!-- Phone-first geometry: Centered column with maximum width -->
    <Grid MaximumWidthRequest="450"
          HorizontalOptions="Center"
          RowDefinitions="Auto,*">

        <!-- Top Toast Overlay -->
        <controls:TopToastView Grid.RowSpan="2" ZIndex="100" />

        <!-- 1. Header: 'Review queue' with waiting count -->
        <Grid Grid.Row="0"
              BackgroundColor="#E60D0B0A"
              Padding="20,16,20,14"
              ColumnDefinitions="*,Auto">

            <VerticalStackLayout Grid.Column="0" Spacing="2">
                <Label Text="{Binding WaitingCountText}"
                       FontFamily="SyneBold"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextPrimary}" />

                <Label Text="Moderator actions for community safety"
                       FontFamily="ManropeRegular"
                       FontSize="12"
                       TextColor="{StaticResource TextMuted}" />
            </VerticalStackLayout>

            <Border Grid.Column="1"
                    StrokeShape="RoundRectangle 9999"
                    BackgroundColor="#26F59E0B"
                    Stroke="{StaticResource WarningAmber}"
                    StrokeThickness="1"
                    Padding="10,4"
                    VerticalOptions="Center">
                <Label Text="🛡️ Moderator"
                       FontFamily="ManropeSemiBold"
                       FontSize="11"
                       TextColor="{StaticResource WarningAmber}" />
            </Border>

            <BoxView HeightRequest="1"
                     Color="{StaticResource BorderGlow}"
                     VerticalOptions="End"
                     Grid.ColumnSpan="2" />
        </Grid>

        <!-- 2. Vertical list of photos awaiting review -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="20" Padding="14,16,14,24">

                <!-- Empty state when all reviews processed -->
                <VerticalStackLayout IsVisible="{Binding QueueItems.Count, Converter={toolkit:InvertedBoolConverter}}"
                                     Spacing="12"
                                     HorizontalOptions="Center"
                                     Padding="32">
                    <Label Text="✓" FontSize="36" TextColor="{StaticResource AccentVermilion}" HorizontalOptions="Center" />
                    <Label Text="Queue is clear!"
                           FontFamily="SyneBold"
                           FontSize="18"
                           TextColor="{StaticResource TextPrimary}"
                           HorizontalOptions="Center" />
                    <Label Text="All pending community flags have been resolved."
                           FontFamily="ManropeRegular"
                           FontSize="13"
                           TextColor="{StaticResource TextMuted}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Cards Stream -->
                <CollectionView ItemsSource="{Binding QueueItems}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ReviewItemViewModel">
                            <!-- Card Container -->
                            <Border StrokeShape="RoundRectangle 20"
                                    Stroke="{StaticResource BorderGlow}"
                                    StrokeThickness="1"
                                    BackgroundColor="{StaticResource AppSurface}"
                                    Margin="0,0,0,18"
                                    Padding="0"
                                    IsClippedToBounds="True">

                                <VerticalStackLayout Spacing="0">
                                    <!-- Photo Image -->
                                    <Image Source="{Binding ImageUrl}"
                                           Aspect="AspectFill"
                                           HeightRequest="240"
                                           HorizontalOptions="Fill" />

                                    <VerticalStackLayout Spacing="12" Padding="14">
                                        <!-- Caption -->
                                        <Label Text="{Binding Caption}"
                                               FontFamily="ManropeRegular"
                                               FontSize="13"
                                               TextColor="{StaticResource TextPrimary}"
                                               LineBreakMode="WordWrap" />

                                        <!-- Small chips showing report count and Adult / Violence / Hate scores as percentages -->
                                        <FlexLayout Wrap="Wrap" AlignItems="Center">
                                            <!-- Report Count Chip -->
                                            <Border StrokeShape="RoundRectangle 9999"
                                                    BackgroundColor="#26EF4444"
                                                    Stroke="{StaticResource DestructiveRed}"
                                                    StrokeThickness="1"
                                                    Padding="10,4"
                                                    Margin="0,0,6,6">
                                                <Label Text="{Binding ReportText}"
                                                       FontFamily="ManropeSemiBold"
                                                       FontSize="11"
                                                       TextColor="{StaticResource DestructiveRed}" />
                                            </Border>

                                            <!-- Adult % Chip -->
                                            <Border StrokeShape="RoundRectangle 9999"
                                                    BackgroundColor="{StaticResource AppSurfaceElevated}"
                                                    Stroke="{StaticResource BorderGlow}"
                                                    StrokeThickness="1"
                                                    Padding="10,4"
                                                    Margin="0,0,6,6">
                                                <Label Text="{Binding AdultPercentText}"
                                                       FontFamily="ManropeSemiBold"
                                                       FontSize="11"
                                                       TextColor="{StaticResource TextPrimary}" />
                                            </Border>

                                            <!-- Violence % Chip -->
                                            <Border StrokeShape="RoundRectangle 9999"
                                                    BackgroundColor="{StaticResource AppSurfaceElevated}"
                                                    Stroke="{StaticResource BorderGlow}"
                                                    StrokeThickness="1"
                                                    Padding="10,4"
                                                    Margin="0,0,6,6">
                                                <Label Text="{Binding ViolencePercentText}"
                                                       FontFamily="ManropeSemiBold"
                                                       FontSize="11"
                                                       TextColor="{StaticResource TextPrimary}" />
                                            </Border>

                                            <!-- Hate % Chip -->
                                            <Border StrokeShape="RoundRectangle 9999"
                                                    BackgroundColor="{StaticResource AppSurfaceElevated}"
                                                    Stroke="{StaticResource BorderGlow}"
                                                    StrokeThickness="1"
                                                    Padding="10,4"
                                                    Margin="0,0,6,6">
                                                <Label Text="{Binding HatePercentText}"
                                                       FontFamily="ManropeSemiBold"
                                                       FontSize="11"
                                                       TextColor="{StaticResource TextPrimary}" />
                                            </Border>
                                        </FlexLayout>

                                        <!-- Three buttons in a row: Approve, Sensitive, Reject -->
                                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" Margin="0,4,0,0">
                                            <!-- Approve Button (Subtle pill) -->
                                            <Button Grid.Column="0"
                                                    Text="Approve"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ReviewQueueViewModel}}, Path=ApproveCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="{StaticResource AppSurfaceElevated}"
                                                    TextColor="{StaticResource TextPrimary}"
                                                    BorderColor="{StaticResource BorderGlow}"
                                                    BorderWidth="1"
                                                    FontFamily="ManropeSemiBold"
                                                    FontSize="12"
                                                    CornerRadius="20"
                                                    HeightRequest="40"
                                                    Padding="0" />

                                            <!-- Sensitive Button (Amber pill) -->
                                            <Button Grid.Column="1"
                                                    Text="Sensitive"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ReviewQueueViewModel}}, Path=MarkSensitiveCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="#26F59E0B"
                                                    TextColor="{StaticResource WarningAmber}"
                                                    BorderColor="{StaticResource WarningAmber}"
                                                    BorderWidth="1"
                                                    FontFamily="ManropeSemiBold"
                                                    FontSize="12"
                                                    CornerRadius="20"
                                                    HeightRequest="40"
                                                    Padding="0" />

                                            <!-- Reject Button (Red pill) -->
                                            <Button Grid.Column="2"
                                                    Text="Reject"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ReviewQueueViewModel}}, Path=RejectCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="#26EF4444"
                                                    TextColor="{StaticResource DestructiveRed}"
                                                    BorderColor="{StaticResource DestructiveRed}"
                                                    BorderWidth="1"
                                                    FontFamily="ManropeSemiBold"
                                                    FontSize="12"
                                                    CornerRadius="20"
                                                    HeightRequest="40"
                                                    Padding="0" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>