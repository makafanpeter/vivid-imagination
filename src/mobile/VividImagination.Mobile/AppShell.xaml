<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="VividImagination.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:VividImagination.Mobile.Pages"
    Title="Vivid Imagination"
    Shell.BackgroundColor="{StaticResource AppBackground}"
    Shell.ForegroundColor="{StaticResource AccentVermilion}"
    Shell.TitleColor="{StaticResource TextPrimary}"
    Shell.UnselectedColor="{StaticResource TextMuted}"
    Shell.TabBarBackgroundColor="#E60D0B0A"
    Shell.TabBarForegroundColor="{StaticResource AccentVermilion}"
    Shell.TabBarTitleColor="{StaticResource AccentVermilion}"
    Shell.TabBarUnselectedColor="{StaticResource TextMuted}">

    <TabBar x:Name="AppTabBar">
        <!-- Feed on the left -->
        <Tab Title="Feed" Route="feed">
            <ShellContent Title="Feed"
                          ContentTemplate="{DataTemplate pages:FeedPage}"
                          Route="feedpage" />
        </Tab>

        <!-- Raised round orange + button in the middle for uploading -->
        <Tab Title="＋" Route="upload">
            <ShellContent Title="Upload"
                          ContentTemplate="{DataTemplate pages:PhotoUploadPage}"
                          Route="uploadpage" />
        </Tab>

        <!-- Review (only visible to moderators) -->
        <Tab x:Name="ReviewTab" Title="Review" Route="review">
            <ShellContent Title="Review"
                          ContentTemplate="{DataTemplate pages:ReviewQueuePage}"
                          Route="reviewpage" />
        </Tab>

        <!-- Me on the right -->
        <Tab Title="Me" Route="profile">
            <ShellContent Title="Me"
                          ContentTemplate="{DataTemplate pages:ProfilePage}"
                          Route="profilepage" />
        </Tab>
    </TabBar>

</Shell>
