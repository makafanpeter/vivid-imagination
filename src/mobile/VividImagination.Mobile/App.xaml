<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:VividImagination.Mobile"
             xmlns:converters="clr-namespace:VividImagination.Mobile.Converters"
             x:Class="VividImagination.Mobile.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
                <ResourceDictionary Source="Resources/Styles/AppStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:AccentVermilionOrMutedConverter x:Key="AccentVermilionOrMutedConverter" />
            <converters:DestructiveRedOrMutedConverter x:Key="DestructiveRedOrMutedConverter" />
            <converters:SelectedSegmentBackgroundConverter x:Key="SelectedSegmentBackgroundConverter" />
            <converters:SelectedSegmentTextColorConverter x:Key="SelectedSegmentTextColorConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
