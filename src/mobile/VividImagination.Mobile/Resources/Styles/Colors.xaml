<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:VividImagination.Mobile.Converters">

    <!-- Value Converters -->
    <converters:AccentVermilionOrMutedConverter x:Key="AccentVermilionOrMutedConverter" />
    <converters:DestructiveRedOrMutedConverter x:Key="DestructiveRedOrMutedConverter" />

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!-- Dark and Warm Design System Palette (Single Dark Palette, No Light Mode) -->
    <Color x:Key="AppBackground">#0D0B0A</Color>
    <Color x:Key="AppSurface">#161311</Color>
    <Color x:Key="AppSurfaceElevated">#221D1A</Color>

    <!-- Typography -->
    <Color x:Key="TextPrimary">#F5F0EB</Color>
    <Color x:Key="TextSecondary">#C9C0B5</Color>
    <Color x:Key="TextMuted">#B5ACA2</Color>

    <!-- Faint Glow Border: White at 15% Opacity (0x26 = 38/255 ≈ 15%) -->
    <Color x:Key="BorderGlow">#26FFFFFF</Color>

    <!-- Single Accent: Hot Orange-Vermilion -->
    <Color x:Key="AccentVermilion">#FF551C</Color>
    <Color x:Key="AccentGlow">#80FF551C</Color>

    <!-- Semantic Reserved Colors -->
    <Color x:Key="DestructiveRed">#EF4444</Color>
    <Color x:Key="WarningAmber">#F59E0B</Color>
    <Color x:Key="SuccessGreen">#22C55E</Color>

    <!-- Legacy / Framework Mappings Aligned to Single Palette -->
    <Color x:Key="Primary">#FF551C</Color>
    <Color x:Key="PrimaryDark">#E0440E</Color>
    <Color x:Key="PrimaryDarkText">#F5F0EB</Color>
    <Color x:Key="Secondary">#221D1A</Color>
    <Color x:Key="SecondaryDarkText">#A89F95</Color>
    <Color x:Key="Tertiary">#FF551C</Color>

    <Color x:Key="DarkBackground">#0D0B0A</Color>
    <Color x:Key="LightOnDarkBackground">#F5F0EB</Color>
    <Color x:Key="LightBackground">#0D0B0A</Color>
    <Color x:Key="DarkOnLightBackground">#F5F0EB</Color>

    <Color x:Key="LightSecondaryBackground">#161311</Color>
    <Color x:Key="DarkSecondaryBackground">#161311</Color>

    <Color x:Key="White">#F5F0EB</Color>
    <Color x:Key="Black">#0D0B0A</Color>
    <Color x:Key="OffBlack">#161311</Color>
    <Color x:Key="Magenta">#FF551C</Color>
    <Color x:Key="MidnightBlue">#161311</Color>

    <Color x:Key="Gray100">#F5F0EB</Color>
    <Color x:Key="Gray200">#E6DFD5</Color>
    <Color x:Key="Gray300">#C9C0B5</Color>
    <Color x:Key="Gray400">#A89F95</Color>
    <Color x:Key="Gray500">#7A7168</Color>
    <Color x:Key="Gray600">#4A423B</Color>
    <Color x:Key="Gray900">#161311</Color>
    <Color x:Key="Gray950">#0D0B0A</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackground}" />
    <SolidColorBrush x:Key="AppSurfaceBrush" Color="{StaticResource AppSurface}" />
    <SolidColorBrush x:Key="AppSurfaceElevatedBrush" Color="{StaticResource AppSurfaceElevated}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}" />
    <SolidColorBrush x:Key="BorderGlowBrush" Color="{StaticResource BorderGlow}" />
    <SolidColorBrush x:Key="AccentVermilionBrush" Color="{StaticResource AccentVermilion}" />
    <SolidColorBrush x:Key="DestructiveRedBrush" Color="{StaticResource DestructiveRed}" />
    <SolidColorBrush x:Key="WarningAmberBrush" Color="{StaticResource WarningAmber}" />
    <SolidColorBrush x:Key="SuccessGreenBrush" Color="{StaticResource SuccessGreen}" />

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>
    <SolidColorBrush x:Key="MagentaBrush" Color="{StaticResource Magenta}"/>
    <SolidColorBrush x:Key="MidnightBlueBrush" Color="{StaticResource MidnightBlue}"/>
    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>