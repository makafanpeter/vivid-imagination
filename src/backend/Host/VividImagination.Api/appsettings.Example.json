{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore": "Information",
      "MassTransit": "Information",
      "OpenIddict": "Information"
    }
  },
  "LoggingOptions": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "System": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=vivid_imagination;Username=vivid_user;Password=vivid_password",
    "Identity": "Host=localhost;Port=5432;Database=vivid_imagination;Username=vivid_user;Password=vivid_password",
    "Social": "Host=localhost;Port=5432;Database=vivid_imagination;Username=vivid_user;Password=vivid_password",
    "Mongo": "mongodb://localhost:27017",
    "Redis": "localhost:6379"
  },
  "MongoOptions": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "vivid_imagination",
    "InitializeIndexes": true
  },
  "Identity": {
    "ConnectionString": "Host=localhost;Port=5432;Database=vivid_imagination;Username=vivid_user;Password=vivid_password"
  },
  "Media": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "vivid_imagination"
  },
  "Moderation": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "vivid_imagination"
  },
  "Feed": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "vivid_imagination"
  },
  "Social": {
    "ConnectionString": "Host=localhost;Port=5432;Database=vivid_imagination;Username=vivid_user;Password=vivid_password"
  },
  "AWS": {
    "Region": "us-east-1",
    "Bucket": "vivid-imagination-photos"
  },
  "Database": {
    "ApplyMigrations": true
  },
  "ClearCacheJob": "0 0/15 * * * ?",
  "Cron": {
    "UsePersistentStore": false,
    "ConnectionStringName": "Postgres"
  },
  "ApplicationSettings": {
    "General": {
      "AppName": "VividImagination",
      "DefaultTimeZoneId": "UTC",
      "AllowUsersToSetTimeZone": true,
      "DefaultAuthProvider": "OpenIdConnect",
      "MessageBrokerType": "RabbitMq",
      "StorageType": "Local",
      "MaxFileSizeInMb": 15,
      "PublicBucket": "vivid-imagination-photos",
      "DefaultClientUrl": "http://localhost:3000",
      "DefaultLogoUrl": "http://localhost:3000/logo.png",
      "DefaultActivationMode": "Immediate",
      "EncryptionKey": "vivid-imagination-dev-encryption-key-32chars!",
      "SecretKey": "vivid-imagination-dev-secret-key-at-least-32-chars-long!"
    },
    "Cache": {
      "EnableDistributedCache": true,
      "DistributedCache": "Redis",
      "ConnectionString": "localhost:6379",
      "DefaultCacheTime": 60,
      "ShortTermCacheTime": 5
    },
    "Http": {
      "ForwardedHttpHeader": "X-Forwarded-For",
      "UseHttpClusterHttps": false,
      "UseHttpXForwardedProto": false,
      "UseInstanceProfile": false
    },
    "Images": {
      "MaxFileSizeInMb": 15,
      "MaximumImageSize": 4096,
      "DefaultImageQuality": 85
    },
    "CORS": {
      "AllowAnyOrigin": true,
      "AllowedOrigins": [
        "http://localhost:3000",
        "http://localhost:5000",
        "https://localhost:7001"
      ]
    },
    "Storage": {
      "Local": {
        "Path": "App_Data/Storage"
      }
    },
    "SecuritySettings": {
      "PasswordMinimumLength": 8,
      "PasswordRequireUppercase": true,
      "PasswordRequireLowercase": true,
      "PasswordRequireNonAlphanumeric": true,
      "PasswordRequireDigit": true,
      "FailedPasswordAllowedAttempts": 5,
      "FailedPasswordLockoutMinutes": 15,
      "RequireUniqueEmail": true
    },
    "OpenIdConnectSettings": {
      "Authority": "https://localhost:7001",
      "Audiences": [
        "vivid-imagination-api"
      ],
      "IssuerUri": "https://localhost:7001",
      "DefaultClientSecret": "vivid-dev-secret",
      "EnableValidation": false
    },
    "DataProtectionSettings": {
      "Storage": "Local",
      "LocalKeysPath": "App_Data/DataProtection"
    },
    "EventBus": {
      "RabbitMQ": {
        "Host": "localhost",
        "Username": "guest",
        "Password": "guest",
        "UseSsl": false
      },
      "SQS": {
        "Region": "us-east-1",
        "UseInstanceProfile": false
      }
    },
    "Jwt": {
      "AccessTokenLifetime": 60,
      "RefreshTokenLifetime": 14
    }
  }
}
